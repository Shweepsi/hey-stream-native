<?xml version="1.0" encoding="utf-8"?>
<!-- Les fournisseurs Xtream servent souvent flux et images en http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
